# ==============================================================================
# Lumina Digital - Production & Gateway Configuration
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (Concierge & Prompt Intelligence).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY CREDENTIALS (MANDATORY FOR PAID CHECKOUT)
# ==============================================================================
# Obtain from Razorpay Dashboard: Settings -> API Keys (https://dashboard.razorpay.com/app/keys)
#
# Test Mode (Prototyping & Sandbox Validation):
#   RAZORPAY_KEY_ID="rzp_test_..."
#   RAZORPAY_KEY_SECRET="..."
#
# Live Production Mode (Real Customer INR Transactions):
#   RAZORPAY_KEY_ID="rzp_live_..."
#   RAZORPAY_KEY_SECRET="..."
#
# NOTE: Both Key ID and Key Secret MUST be provided on the server.
# If omitted, order creation will return HTTP 503 (Service Unavailable).
# Mock orders (order_sbx_*) and simulated signatures are strictly blocked.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# RAZORPAY_WEBHOOK_SECRET: Configured in Razorpay Dashboard -> Settings -> Webhooks.
# Required for asynchronous webhook verification (payment.captured, payment.failed).
# The backend validates the HMAC-SHA256 signature using the raw request body.
# If omitted, webhook endpoints reject events with HTTP 400.
RAZORPAY_WEBHOOK_SECRET=""

# Default payment currency (INR for Indian & global catalog pricing)
RAZORPAY_CURRENCY="INR"

# ==============================================================================
# STORE AUTHORITY & CUSTOMER SUPPORT
# ==============================================================================
# Customer Care & Support Email (Contact form inquiries & customer receipts)
SUPPORT_EMAIL="raj.nikhil0556@gmail.com"

# Authorized Store Owner Account Email (Owner Control Panel & Admin access)
OWNER_EMAIL="raj.nikhil0556@gmail.com"

# Firebase Cloud Project ID (Firestore persistence authority for orders & purchases)
FIREBASE_PROJECT_ID="lumina-digital-71601"


